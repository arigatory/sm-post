{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MartenConfig": {
    "ConnectionString": "Host=localhost;Port=5433;Database=eventstore;Username=postgres;Password=postgres"
  },
  "ProducerConfig": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "SM_Producer",
    "Acks": "All",
    "EnableIdempotence": true,
    "MaxInFlight": 5,
    "MessageSendMaxRetries": 10,
    "RetryBackoffMs": 100
  }
}
